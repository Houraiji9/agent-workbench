{
  "name": "agent-workbench",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "mcp": "tsx src/mcp/index.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "report": "tsx scripts/report.ts",
    "integrations:provision": "node scripts/provision-integrations.mjs",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "electron desktop/main.cjs",
    "test:public": "tsx --test tests/public-start.test.ts",
    "review": "tsx scripts/review.ts",
    "workbench": "tsx scripts/workbench.ts",
    "closeout": "tsx scripts/closeout.ts",
    "agent": "tsx scripts/agent.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.9.0",
    "rcedit": "5.0.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "description": "Windows local-first Agent project workbench",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Houraiji9/agent-workbench.git"
  }
}
